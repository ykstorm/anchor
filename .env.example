# Copy to .env and fill in real values. Never commit .env; it is gitignored.

# OpenAI, required for embedding
OPENAI_API_KEY="sk-REPLACE_ME"

# Postgres connection string.
#   Format: postgresql://USER:PASSWORD@HOST:5432/DB?sslmode=require
#
# Local dev: docker-compose provisions a throwaway Postgres. Its user/password
# default to "anchor" (override with POSTGRES_USER / POSTGRES_PASSWORD in .env),
# so for the bundled stack you can use:
#   postgresql://anchor:anchor@localhost:5432/anchor?sslmode=disable
#
# Deployed environments: use a managed secret, require TLS (sslmode=require),
# and rotate on any suspected exposure. See SECURITY.md → Credential rotation.
DATABASE_URL="postgresql://USER:REPLACE_ME@localhost:5432/anchor?sslmode=disable"

# Optional local docker overrides (defaults shown; consumed by docker-compose.yml)
# POSTGRES_USER=anchor
# POSTGRES_PASSWORD=anchor
# POSTGRES_DB=anchor

# Shared secret for the admin seed endpoint (POST /api/admin/seed). Callers send
# it in an x-seed-token header, not as an Authorization: Bearer token.
# Leave unset to keep that endpoint disabled.
# SEED_TOKEN="REPLACE_ME"

# How many proxies in front of the app add an entry to X-Forwarded-For. The rate
# limiter takes the caller's address that many entries from the right, because
# the entries on the left are whatever the caller sent. A whole number of 1 or
# more; anything else is read as 1. The default of 1 is right for Vercel, which
# overwrites the header with the client address. Raise it only when more
# proxies append to the header. See DEPLOY.md, "Client address and rate limits".
# TRUST_PROXY_HOPS=1
